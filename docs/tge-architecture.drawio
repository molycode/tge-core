        <mxCell id="rule-app" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" value="&lt;b&gt;Apps&lt;/b&gt; compose modules and bridges: run context and schedule, UI, input, policy. Each takes only the bridges it needs. Dev apps live in their module's repo and are never installed." vertex="1">
          <mxGeometry x="880" y="20" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rule-integration" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" value="&lt;b&gt;Bridges&lt;/b&gt;, one per connection more than one app needs. Each names exactly the modules it connects and builds only when the app provides both. Vendors no module, holds no app policy.&lt;br&gt;Solid: next (S2). Dashed: later." vertex="1">
          <mxGeometry x="880" y="210" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rule-modules" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" value="&lt;b&gt;Modules&lt;/b&gt; depend on Core alone. They expose APIs and announce events; none names another." vertex="1">
          <mxGeometry x="880" y="430" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rule-core" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" value="&lt;b&gt;Core&lt;/b&gt;: the shared vocabulary (geometry, material, light, exposure, entity, model data) and small contracts where one module must ask another for something; events, commands, module runtime." vertex="1">
          <mxGeometry x="880" y="545" width="340" height="90" as="geometry" />
        </mxCell>
      </root>
