{
	"version": 6,
	"cmakeMinimumRequired": {
		"major": 4,
		"minor": 1,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "tge-core-base",
			"hidden": true
		},
		{
			"name": "tge-core-linux-gcc-debug",
			"inherits": "tge-core-base",
			"displayName": "tge_core_linux_gcc_debug",
			"description": "Debug build with GCC (uses TGE_GCC_PATH or system GCC)",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/gcc-Debug",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux/gcc.cmake",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "tge-core-linux-gcc-release",
			"inherits": "tge-core-base",
			"displayName": "tge_core_linux_gcc_release",
			"description": "Release build with GCC (uses TGE_GCC_PATH or system GCC)",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/gcc-Release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux/gcc.cmake",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "tge-core-linux-clang-debug",
			"inherits": "tge-core-base",
			"displayName": "tge_core_linux_clang_debug",
			"description": "Debug build with Clang (uses TGE_CLANG_PATH or system Clang)",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/clang-Debug",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux/clang.cmake",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "tge-core-linux-clang-release",
			"inherits": "tge-core-base",
			"displayName": "tge_core_linux_clang_release",
			"description": "Release build with Clang (uses TGE_CLANG_PATH or system Clang)",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/clang-Release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux/clang.cmake",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "tge-core-windows-msvc-debug",
			"inherits": "tge-core-base",
			"displayName": "tge_core_windows_msvc_debug",
			"description": "Debug build with MSVC — run from 'x64 Native Tools Command Prompt for VS 2026'",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/msvc-Debug",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/windows/msvc.cmake",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "tge-core-windows-msvc-release",
			"inherits": "tge-core-base",
			"displayName": "tge_core_windows_msvc_release",
			"description": "Release build with MSVC — run from 'x64 Native Tools Command Prompt for VS 2026'",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/msvc-Release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/windows/msvc.cmake",
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		}
	],
	"buildPresets": [
		{
			"name": "tge-core-linux-gcc-debug",
			"configurePreset": "tge-core-linux-gcc-debug",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
		},
		{
			"name": "tge-core-linux-gcc-release",
			"configurePreset": "tge-core-linux-gcc-release",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
		},
		{
			"name": "tge-core-linux-clang-debug",
			"configurePreset": "tge-core-linux-clang-debug",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
		},
		{
			"name": "tge-core-linux-clang-release",
			"configurePreset": "tge-core-linux-clang-release",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
		},
		{
			"name": "tge-core-windows-msvc-debug",
			"configurePreset": "tge-core-windows-msvc-debug",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
		},
		{
			"name": "tge-core-windows-msvc-release",
			"configurePreset": "tge-core-windows-msvc-release",
			"condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
		}
	]
}
